{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "queues": {
            "messageEncoding": "none",
            "batchSize": 1,
            "newBatchThreshold": 0,
            "visibilityTimeout": "00:01:00",
            "maxDequeueCount": 8
        }
    }
}
